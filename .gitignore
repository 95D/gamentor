# ===============================================
# Android / Gradle Build System
# Source: https://github.com/github/gitignore/blob/main/Gradle.gitignore
# ===============================================

# Generated Gradle directories
.gradle/
build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar and properties
!gradle-wrapper.jar
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Generated build and release artifacts
*.apk
*.aar
*.ap_
*.aab
*.dex

# Local configuration file
local.properties

# ===============================================
# ProGuard / R8
# ===============================================

# Proguard/R8 configuration folder generated by Eclipse
proguard/

# Proguard/R8 map files - generally recommended to KEEP unignored for production tracking
# *.map

# Generated output files (usually in build/ and already ignored)
# usage.txt # (Duplicated) Ignored by 'build/'
# seeds.txt # (Duplicated) Ignored by 'build/'

# NOTE: 'rules.txt' (or 'proguard-rules.pro') is a configuration file and should be committed.

# ===============================================
# Android Studio / IntelliJ IDE
# ===============================================

# IntelliJ/Android Studio project files
.idea/
*.iml

# User-specific stuff
.idea/workspace.xml
.idea/tasks.xml

# Libraries (can be large)
.idea/libraries

# Caches/Metadata
.idea/caches
.idea/modules.xml
.idea/dictionaries
.idea/assetWizardSettings.xml
.idea/gradle.xml

# Android Studio folders
/captures
.externalNativeBuild/
.cxx/
output.json
.navigation/
.android

# Kotlin
.kotlin/

# Lint results
lint-results.html
lint-results.xml

# ===============================================
# General Language / Archives
# Source: https://github.com/github/gitignore/blob/main/Java.gitignore
# ===============================================

# Logcat/Log files
logcat.txt
*.log

# Keystore files
*.jks
*.keystore

# Profiling
*.hprof

# Compiled class files
*.class

# Packages
*.jar
*.war
*.nar
*.ear

# Archive and cache files
*.zip
*.tar
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
reply_pid*

# ===============================================
# Operating System (OS) Specific Files
# Items previously recommended for global ignore are now included here for organization-wide control.
# ===============================================

# macOS (Source: https://github.com/github/gitignore/blob/main/Global/macOS.gitignore)
.DS_Store
.AppleDouble
.LSOverride
Icon\r
._*
.Spotlight-V100
.Trashes

# Linux (Source: https://github.com/github/gitignore/blob/main/Global/Linux.gitignore)
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# Windows (Source: https://github.com/github/gitignore/blob/main/Global/Windows.gitignore)
Thumbs.db
ehthumbs.db
Desktop.ini

# Vim (Source: https://github.com/github/gitignore/blob/main/Global/Vim.gitignore)
# *~ # (Duplicated) Already covered in Linux section
*.swp
.sw[a-z]
.swo
.netrwhist
Session.vim
.tags
